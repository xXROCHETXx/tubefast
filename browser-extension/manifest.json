{
  "manifest_version": 3,
  "name": "Tubefast Connect",
  "version": "1.0.0",
  "description": "Conecta tu sesión actual de YouTube con Tubefast, solo cuando lo solicitas.",
  "key": "",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_icon": {"32": "icon32.png"},
    "default_popup": "popup.html",
    "default_title": "Conectar Tubefast"
  },
  "icons": {"32": "icon32.png", "48": "icon48.png", "128": "icon128.png"},
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:17889"
  }
}
